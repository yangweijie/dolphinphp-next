APP_DEBUG = true

# 数据库配置 - 支持mysql和sqlite
# 使用mysql时取消下面注释并配置相关参数
# DB_DRIVER = mysql
# DB_TYPE = mysql
# DB_HOST = 127.0.0.1
# DB_NAME = dolphinphp
# DB_USER = root
# DB_PASS = 
# DB_PORT = 3306
# DB_CHARSET = utf8mb4
# DB_PREFIX = dp_

# 使用sqlite（默认，无需额外安装）
DB_DRIVER = sqlite
DB_SQLITE_PATH = ./database/database.sqlite
DB_PREFIX = dp_

DEFAULT_LANG = zh-cn

# JWT配置
JWT_KEY = your_jwt_secret_key
JWT_ALG = HS256
JWT_EXPIRE = 3600

# 应用密钥
APP_KEY = your_app_secret_key

# Redis配置
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD = 
REDIS_SELECT = 0
REDIS_TIMEOUT = 0
REDIS_EXPIRE = 3600
REDIS_PERSISTENT = false
REDIS_PREFIX = zbuilder:
